# ============================================================
# Konfigurasi aplikasi Tangklet Dokter
# Salin file ini menjadi ".env" lalu isi nilainya.
# ============================================================

# Port server lokal
PORT=3000

# ---- Koneksi PostgreSQL ----
# Cara 1 (disarankan): satu URL koneksi
# DATABASE_URL=postgres://postgres:PASSWORD_ANDA@127.0.0.1:5432/tangklet_dokter
#
# Cara 2: variabel terpisah (dipakai bila DATABASE_URL kosong)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=tangklet_dokter

# Nama database yang akan dibuat otomatis oleh "npm run db:setup"
DB_NAME=tangklet_dokter

# ---- Sesi & keamanan ----
# WAJIB diganti dengan string acak panjang di produksi.
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Set "true" bila situs sudah diakses lewat HTTPS (cookie Secure).
COOKIE_SECURE=false

# ---- Penyimpanan poster ----
# Lokal: folder "uploads" di project. Produksi: arahkan ke object storage
# dan sesuaikan UPLOADS_URL_BASE / logika penyimpanan sesuai hosting.
UPLOAD_DIR=uploads
# Basis URL publik untuk file yang diunggah (kosongkan bila satu domain).
UPLOADS_URL_BASE=/uploads
# Batas ukuran unggahan poster (dalam MB)
MAX_UPLOAD_MB=5

# ---- Akun admin awal (dibuat oleh "npm run db:setup") ----
# Password default tiap RS. Ganti segera setelah login pertama.
DEFAULT_ADMIN_PASSWORD=Demak#2026
